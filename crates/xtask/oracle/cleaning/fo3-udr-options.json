{
  "description": "The same deleted references to moveable statics with every UDR option away from the Fallout 3 defaults: the moveable static base becomes [000389C6] (UDRSetMSTTValue), the references move to the height -12345.5 (UDRSetZ on), get the scale 2 (UDRSetScale on) and no player enable parent (UDRSetXESP off).",
  "game": "fo3",
  "load": ["Fallout3.esm"],
  "prepare": {
    "file": "UdrMstt.esp",
    "commands": [
      {"command": "files.new", "params": {"file": "UdrMstt"}},
      {"command": "records.copy", "params": {"form_id": "00045026", "from": "Fallout3.esm", "to": "UdrMstt.esp"}},
      {"command": "records.copy", "params": {"form_id": "000648B1", "from": "Fallout3.esm", "to": "UdrMstt.esp"}},
      {"command": "records.set_deleted", "params": {"form_id": "00045026", "file": "UdrMstt.esp"}},
      {"command": "records.set_deleted", "params": {"form_id": "000648B1", "file": "UdrMstt.esp"}}
    ]
  },
  "select": ["UdrMstt.esp"],
  "udr": true,
  "options": {"udr_xesp": false, "udr_scale": true, "udr_scale_value": 2.0, "udr_z": true, "udr_z_value": -12345.5, "udr_mstt": true, "udr_mstt_value": "000389C6"},
  "save": ["UdrMstt.esp"]
}
