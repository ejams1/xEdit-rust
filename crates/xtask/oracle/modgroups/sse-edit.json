    },
    {
      "class": "TfrmModGroupEdit",
      "title": "Editing",
      "button": "OK"
    },
    {
      "class": "TfrmModGroupSelect",
      "title": "Reloading",
      "button": "OK"
    }
  ],
  "port": [
    {
      "command": "modgroups.edit",
      "params": {
        "name": "AAA edit me",
        "add_current_crcs": true
      }
    }
  ]
