{
  "description": "Preset save of the selection dialog: a new name is typed into the combo box and Save writes the current selection as a preset (no question, the preset did not exist), then an existing preset is typed and Save writes it too, behind the overwrite question answered Yes (a dialog that stays with the answers of one window, `repeat`). OK confirms the dialog, which saves the selection and activates it; the settings file holds both presets and the untouched selection.",
  "game": "sse",
  "load": [
    "Skyrim.esm",
    "Update.esm"
  ],
  "files": {
    "Update.modgroups": [
      "[One]",
      "Skyrim.esm",
      "Update.esm",
      "[Two]",
      "Update.esm",
      "@Skyrim.esm"
    ]
  },
  "settings": [
    "[ModGroups]",
    "Selection=\"Two\"",
    "[frmModGroupSelect_ActiveModGroups_Presets]",
    "Mine=\"One\"",
    "[Init]",
    "FirstStart=1"
  ],
  "menu": [
    "mniViewModGroupsReload"
  ],
  "answers": [
    {
      "class": "TfrmModGroupSelect",
      "title": "Reloading",
      "text": "Fresh",
      "control": "TComboBox",
      "button": "&Save"
    },
    {
      "class": "TfrmModGroupSelect",
      "title": "Reloading",
      "repeat": true,
      "text": "Mine",
      "control": "TComboBox",
      "button": "&Save"
    },
    {
      "class": "#32770",
      "title": "Confirm",
      "button": "&Yes"
    },
    {
      "class": "TfrmModGroupSelect",
      "title": "Reloading",
      "repeat": true,
      "button": "OK"
    }
  ],
  "port": [
    {
      "command": "modgroups.preset_save",
      "params": {
        "preset": "Fresh"
      }
    },
    {
      "command": "modgroups.preset_save",
      "params": {
        "preset": "Mine",
        "confirm": true
      }
    },
    {
      "command": "modgroups.select",
      "params": {
        "saved": true
      }
    }
  ]
}
